@startuml
title Restaurant Rush - Stage 3 class diagram (final design)\n<color:#1F6FB2>Blue = new in Stage 3</color>    <color:#B85450>Red border = changed in Stage 3</color>
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontSize 11
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 55
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #444444
}
skinparam class<<new>> {
  BackgroundColor #DCEBFA
  BorderColor #1F6FB2
}
skinparam class<<changed>> {
  BorderColor #B85450
  BorderThickness 2
}
hide <<new>> stereotype
hide <<changed>> stereotype

package app {
  class Main {
    +{static} main(args: String[]): void
  }
}

package ui {
  class RestaurantCLI <<boundary>> <<changed>> {
    -scanner: Scanner
    -engine: GameEngine
    +RestaurantCLI(engine: GameEngine)
    +run(): void
    -printMenu(): void
    -printState(startEvents: List<String>): void
    -promptHappyHour(): void
    -promptHost(): void
    -promptWaiter(): void
    -promptChef(): void
    -printSummary(ts: TurnSummary): void
    -printFinalResult(result: GameResult): void
    -readInt(prompt: String): int
  }
}

package core {
  class GameEngine <<control>> <<changed>> {
    -restaurant: Restaurant
    -host: Host
    -waiter: Waiter
    -chef: Chef
    -cashier: Cashier
    -schedule: ArrivalSchedule
    -config: GameConfig
    -currentTurn: int
    +startTurn(): List<String>
    +canActivateHappyHour(): boolean
    +activateHappyHour(): ActionResult
    -applyHappyHourRecovery(): List<String>
    +hostCanSeat(): boolean
    +applyHostAction(customerId: int): ActionResult
    +availableWaiterTasks(): List<WaiterTask>
    +ordersAwaitingPreparation(): List<Order>
    +applyWaiterAction(task: WaiterTask, targetId: int): ActionResult
    +applyChefAction(orderId: int): ActionResult
    +finishTurn(): TurnSummary
    +isGameOver(): boolean
    +evaluateResult(): GameResult
  }
  class GameConfig {
    -maxTurns: int = 18
    -tableCount: int = 2
    -arrivalTurns: List<Integer>
    -arrivalTypes: List<CustomerType>
    -targetPaid: int = 4
    -targetRevenueCents: int = 4500
    -targetSatisfaction: int = 60
    +GameConfig()
    +GameConfig(arrivalTypes: List<CustomerType>)
    +{static} regularOnly(): GameConfig
    +getters()
  }
  class ArrivalSchedule {
    -arrivalTurns: List<Integer>
    -arrivalTypes: List<CustomerType>
    -nextCustomerId: int
    +customerArrivingOn(turn: int): Optional<Customer>
  }
  class GameStats {
    -revenueCents: int
    -paidCount: int
    -satisfactionTotal: int
    -servedCount: int
    -abandonedCount: int
    +recordPayment(cents: int, satisfaction: int): void
    +recordServed(): void
    +recordAbandon(): void
    +getAverageSatisfaction(): Optional<Double>
    +evaluate(cfg: GameConfig): GameResult
  }
  class TurnSummary <<value object>> {
    -turnNumber: int
    -servedCount: int
    -unhappyDepartures: int
    -revenueCents: int
    -averageSatisfaction: Optional<Double>
    -events: List<String>
    +getters()
  }
  class ActionResult <<value object>> {
    -success: boolean
    -message: String
    +{static} ok(msg: String): ActionResult
    +{static} fail(reason: String): ActionResult
    +isSuccess(): boolean
    +getMessage(): String
  }
}

package staff {
  abstract class Staff {
    -name: String
    -actedThisTurn: boolean
    +resetTurn(): void
    +hasActed(): boolean
    #markActed(): void
  }
  class Host <<new>> {
    +seat(c: Customer, t: Table, r: Restaurant, turn: int): ActionResult
  }
  class Waiter <<changed>> {
    +seat(c: Customer, t: Table, r: Restaurant, turn: int): ActionResult
    +takeOrder(c: Customer, r: Restaurant): ActionResult
    +serve(o: Order, r: Restaurant, turn: int): ActionResult
  }
  class Chef {
    +prepare(o: Order): ActionResult
  }
  class Cashier {
    +collectPayment(r: Restaurant): Optional<Order>
  }
}

package domain {
  class Restaurant <<changed>> {
    -tables: List<Table>
    -queue: WaitingQueue
    -menu: Menu
    -customers: List<Customer>
    -orders: List<Order>
    -stats: GameStats
    -happyHour: HappyHour
    +addToQueue(c: Customer): void
    +seatCustomer(c: Customer, t: Table, turn: int): void
    +createOrder(c: Customer, item: MenuItem): Order
    +findFreeTable(): Optional<Table>
    +getReadyToPayOldestFirst(): List<Customer>
    +removeAbandoned(c: Customer): void
    +getActiveOrderOf(c: Customer): Optional<Order>
    +getHappyHour(): HappyHour
  }
  class Table {
    -tableId: int
    -occupant: Customer
    +isFree(): boolean
    +seat(c: Customer): void
    +free(): void
  }
  class WaitingQueue {
    -waiting: Deque<Customer>
    +enqueue(c: Customer): void
    +remove(c: Customer): void
    +getAll(): List<Customer>
  }
  abstract class Customer <<changed>> {
    +{static} MAX_SATISFACTION: int = 100
    -{static} COMBO_EVERY: int = 3
    -id: int
    -satisfaction: int
    -state: CustomerState
    -seatedTurn: int
    -servedTurn: int
    -readyToPayTurn: int
    +{abstract} waitingLoss(): int
    +{abstract} typeName(): String
    +chooseFood(menu: Menu): MenuItem
    +applyDiscount(priceCents: int): int
    +applyWaitingLoss(): void
    +recoverSatisfaction(points: int): void
    +isWaitingForService(): boolean
    +isAbandoned(): boolean
  }
  class RegularCustomer {
    +waitingLoss(): int {returns 8}
    +typeName(): String
  }
  class VIPCustomer {
    +waitingLoss(): int {returns 5}
    +applyDiscount(priceCents: int): int {10% off}
    +typeName(): String
  }
  class CriticCustomer {
    +waitingLoss(): int {returns 12}
    +chooseFood(menu: Menu): MenuItem {most expensive}
    +typeName(): String
  }
  class CustomerFactory <<factory>> {
    +{static} create(type: CustomerType, id: int): Customer
  }
  class Menu <<changed>> {
    -items: List<MenuItem>
    -combos: List<ComboMeal>
    +get(index: int): MenuItem
    +size(): int
    +getAll(): List<MenuItem>
    +getCombo(index: int): ComboMeal
    +comboCount(): int
    +getCombos(): List<ComboMeal>
    +getMostExpensive(): MenuItem
  }
  class MenuItem {
    -name: String
    -priceCents: int
    -prepUnits: int
    +getName(): String
    +getPriceCents(): int
    +getPrepUnits(): int
  }
  class ComboMeal <<new>> {
    -{static} PERCENT_PAID: int = 90
    -first: MenuItem
    -second: MenuItem
    +ComboMeal(first: MenuItem, second: MenuItem)
    -{static} comboPrice(a: MenuItem, b: MenuItem): int
    +getComponents(): List<MenuItem>
  }
  class Order <<changed>> {
    -orderId: int
    -customer: Customer
    -item: MenuItem
    -priceCents: int
    -happyHourPrice: boolean
    -unitsDone: int
    -status: OrderStatus
    +Order(id: int, c: Customer, item: MenuItem, hh: HappyHour)
    +advance(): void
    +markServed(): void
    +markPaid(): void
    +cancel(): void
    +isReady(): boolean
    +getPriceCents(): int
  }
  class HappyHour <<new>> {
    +{static} DURATION_TURNS: int = 2
    +{static} RECOVERY: int = 15
    -{static} PERCENT_PAID: int = 80
    -used: boolean
    -turnsRemaining: int
    +canActivate(): boolean
    +activate(): void
    +isActive(): boolean
    +getTurnsRemaining(): int
    +applyDiscount(priceCents: int): int
    +endTurn(): boolean
  }
}

package enums {
  enum CustomerState {
    QUEUED
    SEATED
    ORDERED
    EATING
    READY_TO_PAY
    PAID
    ABANDONED
  }
  enum OrderStatus {
    PLACED
    READY
    SERVED
    PAID
    CANCELLED
  }
  enum CustomerType {
    REGULAR
    VIP
    CRITIC
  }
  enum WaiterTask {
    SEAT
    TAKE_ORDER
    SERVE
    WAIT
  }
  enum GameResult {
    VICTORY
    DEFEAT
  }
}

package util {
  class Money <<utility>> {
    +{static} fromDollars(d: double): int
    +{static} format(cents: int): String
  }
}

' ---- wiring
Main ..> RestaurantCLI : creates
Main ..> GameEngine : creates
RestaurantCLI --> "1" GameEngine
RestaurantCLI ..> TurnSummary
RestaurantCLI ..> ActionResult

GameEngine --> "1" Restaurant
GameEngine --> "1" Host
GameEngine --> "1" Waiter
GameEngine --> "1" Chef
GameEngine --> "1" Cashier
GameEngine --> "1" ArrivalSchedule
GameEngine --> "1" GameConfig
GameEngine ..> TurnSummary : creates
GameEngine ..> WaiterTask

ArrivalSchedule ..> CustomerFactory : uses
ArrivalSchedule --> "6" CustomerType
GameConfig --> "6" CustomerType
CustomerFactory ..> RegularCustomer : creates
CustomerFactory ..> VIPCustomer : creates
CustomerFactory ..> CriticCustomer : creates
GameStats ..> GameResult
GameStats ..> GameConfig

Staff <|-- Host
Staff <|-- Waiter
Staff <|-- Chef
Staff <|-- Cashier
Host ..> Restaurant : seatCustomer()
Waiter ..> Restaurant
Chef ..> Order
Cashier ..> Restaurant
Host ..> ActionResult
Waiter ..> ActionResult
Chef ..> ActionResult

Restaurant *-- "2" Table
Restaurant *-- "1" WaitingQueue
Restaurant *-- "0..*" Order
Restaurant *-- "1" GameStats
Restaurant *-- "1" HappyHour
Restaurant o-- "1" Menu
Restaurant o-- "0..*" Customer
WaitingQueue o-- "0..*" Customer
Table --> "0..1" Customer : occupant

Customer <|-- RegularCustomer
Customer <|-- VIPCustomer
Customer <|-- CriticCustomer
Customer --> "1" CustomerState

Menu *-- "3" MenuItem : items
Menu *-- "2" ComboMeal : combos
MenuItem <|-- ComboMeal
ComboMeal o-- "2" MenuItem : components
Menu ..> Money

Order --> "1" Customer
Order --> "1" MenuItem
Order --> "1" OrderStatus
Order ..> HappyHour : price locked\nat order time

note top of Customer
  <b>Polymorphism</b>: GameEngine, Waiter, Order and Cashier
  only call waitingLoss(), chooseFood() and applyDiscount().
  Each subclass gives its own answer, so there are
  no type checks in the turn controller.
end note
note bottom of ComboMeal
  <b>Inheritance + composition</b>: a ComboMeal <i>is a</i> MenuItem
  (Chef, Order, Cashier treat it like any dish) and
  <i>has</i> two component MenuItems.
  Units = sum; price = 90% of total.
end note
note right of HappyHour
  <b>Encapsulation</b>: used and turnsRemaining are private;
  only activate() / endTurn() change them, so Happy Hour
  can run once, for exactly two turns.
  Bill = list price -> Customer.applyDiscount()
  -> HappyHour.applyDiscount()
end note
note bottom of Restaurant
  <b>Composition</b>: Restaurant owns its tables,
  queue, orders, stats and Happy Hour.
end note
@enduml
