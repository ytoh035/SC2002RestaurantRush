ndFill=0;endSize=10;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c111" target="c107"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t212" value="SC2002 Restaurant Rush: Stage 2 Class Diagram" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="42" y="14" width="1300" height="34" as="geometry"/></mxCell><mxCell id="t213" value="Colour = package: ui (yellow), core (red), domain (green), staff (blue), enums (purple), util (grey). Stereotypes: boundary = UI, control = turn logic, entity = domain objects. Thick outline = new in Stage 2. Dashed outline = modified in Stage 2 (changed members in bold). Trivial getters and setters are omitted." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="42" y="48" width="1700" height="20" as="geometry"/></mxCell><mxCell id="n214" value="&lt;b&gt;Encapsulation example&lt;/b&gt;&lt;br&gt;Staff.actedThisTurn is private; subclasses can set it only via the protected markActed(). Order.priceCents is final." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffe0;strokeColor=#b8a000;" vertex="1" parent="1"><mxGeometry x="42" y="719" width="178" height="82" as="geometry"/></mxCell><mxCell id="n215" value="&lt;b&gt;Composition example&lt;/b&gt;&lt;br&gt;Restaurant creates and owns its Tables, WaitingQueue, GameStats and Orders; none outlives the Restaurant." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffe0;strokeColor=#b8a000;" vertex="1" parent="1"><mxGeometry x="42" y="858" width="230" height="68" as="geometry"/></mxCell><mxCell id="n216" value="&lt;b&gt;Polymorphism example&lt;/b&gt;&lt;br&gt;Callers use only the Customer type. Regular, VIP and Critic override waitingLoss(), applyDiscount() and chooseFood(); GameEngine has no type checks." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffe0;strokeColor=#b8a000;" vertex="1" parent="1"><mxGeometry x="1665" y="1625" width="262" height="104" as="geometry"/></mxCell><mxCell id="e217" value="" style="html=1;rounded=0;strokeColor=#333333;strokeWidth=1.2;dashed=1;dashPattern=1 3;endArrow=none;strokeColor=#b8a000;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n214" target="c51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e218" value="" style="html=1;rounded=0;strokeColor=#333333;strokeWidth=1.2;dashed=1;dashPattern=1 3;endArrow=none;strokeColor=#b8a000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="1" source="n215" target="c67"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e219" value="" style="html=1;rounded=0;strokeColor=#333333;strokeWidth=1.2;dashed=1;dashPattern=1 3;endArrow=none;strokeColor=#b8a000;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n216" target="c107"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l220" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="31" y="1580" width="425" height="330" as="geometry"/></mxCell><mxCell id="t221" value="Notation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="1588" width="200" height="20" as="geometry"/></mxCell><mxCell id="l222" value="" style="html=1;strokeColor=#333333;strokeWidth=1.2;endArrow=block;endFill=0;endSize=14;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="47" y="1626" as="sourcePoint"/><mxPoint x="131" y="1626" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t223" value="Inheritance (generalisation)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="145" y="1617" width="300" height="18" as="geometry"/></mxCell><mxCell id="l224" value="" style="html=1;strokeColor=#333333;strokeWidth=1.2;startArrow=diamond;startFill=1;startSize=14;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="47" y="1658" as="sourcePoint"/><mxPoint x="131" y="1658" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t225" value="Composition (owner creates and owns part)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="145" y="1649" width="300" height="18" as="geometry"/></mxCell><mxCell id="l226" value="" style="html=1;strokeColor=#333333;strokeWidth=1.2;startArrow=diamond;startFill=0;startSize=14;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="47" y="1690" as="sourcePoint"/><mxPoint x="131" y="1690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t227" value="Aggregation (holds references)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="145" y="1681" width="300" height="18" as="geometry"/></mxCell><mxCell id="l228" value="" style="html=1;strokeColor=#333333;strokeWidth=1.2;endArrow=open;endFill=0;endSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="47" y="1722" as="sourcePoint"/><mxPoint x="131" y="1722" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t229" value="Association (navigable, with role)" style="text;html=1;strokeColor=none;fillColor=none;align=lef