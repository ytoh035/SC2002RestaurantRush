@startuml
skinparam shadowing false
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 260
skinparam defaultFontSize 12
skinparam ParticipantPadding 6
skinparam note {
  BackgroundColor #FFF8DC
  BorderColor #B8A040
}
title Stage 3 sequence diagram - Use case: a VIP orders during Happy Hour, from arrival to payment\n(Base setting, tests/victory.txt, turns 4 to 7 shown, then the result check)
actor Manager
participant ":RestaurantCLI" as CLI <<boundary>>
participant ":GameEngine" as GE <<control>>
participant ":Host" as H
participant ":Waiter" as W
participant ":Chef" as CH
participant ":Cashier" as CA
participant ":ArrivalSchedule" as AS
participant "CustomerFactory" as CF <<factory>>
participant ":Restaurant" as R
participant ":HappyHour" as HH
participant "table2:Table" as T
participant "c2:VIPCustomer" as C2
participant ":Menu" as M
participant "o2:Order" as O
participant ":GameStats" as GS

note over Manager, GE
Starting conditions (start of turn 4):
- Customer 1 (Regular) is EATING at Table 1.
- Table 2 is free. Happy Hour has not been used.
- Customer 2 is scheduled to arrive this turn as a VIP.
Outcome: customer 2 pays $10.80 ($15.00 x 0.9 x 0.8) on turn 7
with satisfaction 100; after turn 18 the game ends in VICTORY
(5 paid, revenue $77.10, avg satisfaction 83.2).
end note

loop !engine.isGameOver() - one pass per turn (CLI.run())
== Turn 4: VIP arrives, Happy Hour is switched on, Host seats, Waiter takes the order ==
CLI -> GE : startTurn()
activate GE
GE -> AS : customerArrivingOn(4)
AS -> CF : create(CustomerType.VIP, 2)
create C2
CF -> C2 : new VIPCustomer(2)
note right of C2 : satisfaction = 100, state = QUEUED
AS --> GE : Optional(c2)
GE -> R : addToQueue(c2)
GE -> H : resetTurn()
note right of H : Waiter, Chef and Cashier\nare reset the same way
GE -> R : getHappyHour()
GE -> HH : isActive()
HH --> GE : false
GE --> CLI : events ["Customer 2 (VIP) arrives ..."]
deactivate GE
CLI -> CLI : printState(events)
CLI -> GE : canActivateHappyHour()
GE --> CLI : true
CLI -> Manager : Happy Hour: 1=Switch on now 2=Not now
alt Manager switches Happy Hour on  (manager choice that changes the outcome)
  CLI -> GE : activateHappyHour()
  activate GE
  GE -> HH : canActivate()
  HH --> GE : true
  note right of GE : guard: no staff has acted yet\n(only at the start of a turn)
  GE -> HH : activate()
  note right of HH : used = true\nturnsRemaining = 2
  loop for each customer c  (Happy Hour recovery)
    GE -> C2 : recoverSatisfaction(15)
    note right of C2 : waiting (QUEUED), but already at 100:\nstays 100 (maximum).\nCustomer 1 is EATING, so not affected.
  end
  GE --> CLI : ActionResult.ok("Happy Hour is ON for this turn and the next ...")
  deactivate GE
else Not now
  note over CLI, HH : No discount: the VIP's Burger would cost $13.50,\nand there is no recovery on turn 5 (satisfaction stays 95).
end
CLI -> Manager : Host: 1=Seat 2=Wait
Manager --> CLI : Seat, customer 2
CLI -> GE : applyHostAction(2)
GE -> R : getCustomerById(2)
GE -> R : findFreeTable()
R --> GE : Optional(table2)
GE -> H : seat(c2, table2, restaurant, 4)
note right of H : guards: !hasActed()\nc2.getState() == QUEUED\ntable2.isFree()
H -> R : seatCustomer(c2, table2, 4)
R -> T : seat(c2)
R -> R : queue.remove(c2)
R -> C2 : setState(SEATED)
R -> C2 : setSeatedTurn(4)
H -> H : markActed()
H --> GE : ActionResult.ok("Host seats Customer 2 at table 2.")
note over CLI, W : Because the Host seated c2, the Waiter is free to take the order in the same turn.
CLI -> Manager : Waiter: 1=Seat 2=Take order 3=Serve 4=Wait
Manager --> CLI : Take order, customer 2
CLI -> GE : applyWaiterAction(TAKE_ORDER, 2)
GE -> W : takeOrder(c2, restaurant)
note right of W : guards: !hasActed()\nc2.getState() == SEATED
W -> C2 : chooseFood(menu)
C2 -> M : comboCount()
note right of C2 : id 2 is not a multiple of 3,\nso no combo: menu index (2 - 1) mod 3
C2 -> M : get(1)
M --> C2 : Burger
C2 --> W : Burger
W -> R : createOrder(c2, Burger)
create O
R -> O : new Order(2, c2, Burger, happyHour)
O -> C2 : applyDiscount(1500)
C2 --> O : 1350
note right of C2 #E6F2FF : **Stage 2 VIP pricing** (polymorphism):\nVIPCustomer overrides applyDiscount(), 10% off
O -> HH : isActive()
HH --> O : true
O -> HH : applyDiscount(1350)
HH --> O : 1080
note right of O #E6F2FF : **Stage 3 Happy Hour pricing**:\nVIP first, then 20% off. priceCents = 1080 ($10.80)\nis locked now; happyHourPrice = true; status = PLACED
R --> W : o2
W -> C2 : setState(ORDERED)
W -> W : markActed()
W --> GE : ActionResult.ok("Customer 2 orders Burger ...")
CLI -> Manager : Chef: 1=Prepare 2=Wait
Manager --> CLI : Prepare order 2
CLI -> GE : applyChefAction(2)
GE -> CH : prepare(o2)
note right of CH : guards: !hasActed()\no2.getStatus() == PLACED
CH -> O : advance()
note right of O : unitsDone 1/1 -> READY.\nThe Waiter already acted, so o2 is served next turn.
CLI -> GE : finishTurn()
activate GE
GE -> CA : collectPayment(restaurant)
note right of CA : customer 1 pays $9.00 (same calls as turn 7)
loop for each customer c  (step 5: waiting)
  GE -> C2 : applyWaitingLoss()
  C2 -> C2 : waitingLoss()
  note right of C2 : VIP returns 5: satisfaction 100 -> 95
  GE -> C2 : isAbandoned()
  C2 --> GE : false
end
GE -> HH : endTurn()
note right of HH : turnsRemaining 2 -> 1
HH --> GE : false (not finished yet)
GE --> CLI : TurnSummary
deactivate GE

== Turn 5: Happy Hour's second turn - recovery, then the Waiter serves ==
CLI -> GE : startTurn()
activate GE
GE -> HH : isActive()
HH --> GE : true
loop for each customer c  (Happy Hour recovery at turn start)
  GE -> C2 : recoverSatisfaction(15)
  note right of C2 : still waiting for food (ORDERED):\n95 -> 100 (capped at 100)
end
GE --> CLI : events ["Happy Hour: Customer 2 recovers 95 -> 100."]
deactivate GE
note over CLI, GE : canActivateHappyHour() is now false, so the Happy Hour question is not asked again.
Manager --> CLI : Host: Wait
CLI -> GE : applyHostAction(0)
Manager --> CLI : Waiter: Serve, order 2
CLI -> GE : applyWaiterAction(SERVE, 2)
GE -> W : serve(o2, restaurant, 5)
note right of W : guard: o2.getStatus() == READY
W -> O : markServed()
W -> C2 : setState(EATING)
W -> C2 : setServedTurn(5)
W -> GS : recordServed()
W --> GE : ActionResult.ok("Order #2 (Burger) served to Customer 2.")
CLI -> GE : finishTurn()
GE -> C2 : applyWaitingLoss()
note right of C2 : EATING: no loss, stays 100
GE -> HH : endTurn()
note right of HH : turnsRemaining 1 -> 0
HH --> GE : true
GE --> CLI : TurnSummary (event "Happy Hour has ended.")

== Turn 6: customer 2 finishes eating ==
CLI -> GE : finishTurn()
GE -> CA : collectPayment(restaurant)
CA --> GE : Optional.empty()  (nobody READY_TO_PAY before this turn)
loop for each customer c  (step 4: eating)
  opt c.getState() == EATING and c.getServedTurn() (5) < currentTurn (6)
    GE -> C2 : setState(READY_TO_PAY)
    GE -> C2 : setReadyToPayTurn(6)
  end
end

== Turn 7: the Cashier collects payment ==
note over CLI, H : customer 3 arrives; the Host seats them and the Waiter takes their combo order
CLI -> GE : finishTurn()
activate GE
GE -> CA : collectPayment(restaurant)
CA -> R : getReadyToPayOldestFirst()
R --> CA : [c2]
CA -> R : getActiveOrderOf(c2)
R --> CA : Optional(o2)
CA -> O : getPriceCents()
O --> CA : 1080
CA -> C2 : getSatisfaction()
C2 --> CA : 100
CA -> GS : recordPayment(1080, 100)
note right of GS : revenue += $10.80, paidCount++,\nsatisfaction 100 recorded
CA -> O : markPaid()
CA -> C2 : setState(PAID)
CA -> R : getTableOf(c2)
R --> CA : Optional(table2)
CA -> T : free()
CA -> CA : markActed()
CA --> GE : Optional(o2)
GE --> CLI : TurnSummary ("Cashier collects $10.80 from Customer 2 ...")
deactivate GE
== Turns 8 to 18: the other customers follow the same pattern ==
end

== After turn 18: result check ==
CLI -> GE : isGameOver()
GE --> CLI : true (currentTurn > 18)
CLI -> GE : evaluateResult()
GE -> GS : evaluate(config)
alt paidCount >= 4 and revenue >= 4500 cents and average satisfaction >= 60
  GS --> GE : VICTORY
else any target missed
  GS --> GE : DEFEAT
end
GE --> CLI : GameResult
CLI -> Manager : printFinalResult()  RESULT: VICTORY
@enduml
